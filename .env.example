# Required. Server-to-server key the tally-analytics-backend proxy must send
# as the X-API-Key header. Generate a long random value; never put this in
# frontend/browser code.
API_KEY=changeme

# Comma-separated origins allowed to call this API directly with JS
# (fetch/XHR). Not needed for plain <img> loading of signed thumbnail/photo
# URLs, and not needed for the proxy path from tally-analytics-backend.
# Mainly useful for the /test sanity page. Leave empty to allow none.
ALLOWED_ORIGINS=http://localhost:5173

# Where the catalog, generated index, and generated thumbnails live on disk.
CATALOG_DIR=./data/catalog
INDEX_DIR=./data/index
THUMBS_DIR=./data/thumbs

# Embedding model: clip-vit-b32 | dinov2-small | dinov2-base
MODEL_NAME=dinov2-small

# Public URL this service is reachable at (Cloudflare Tunnel hostname
# locally, or the Railway URL in production). Used to build signed image
# URLs returned in API responses.
PUBLIC_BASE_URL=http://localhost:8000
